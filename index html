<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CV - María Inés Coaquira Niña</title>
<style>
  :root {
    --navy: #1B2A41;
    --gold: #C9A24B;
    --cream: #FAF6EC;
    --text: #3E4552;
    --serif: "Cormorant Garamond", "Playfair Display", Georgia, "Times New Roman", serif;
    --sans: "Segoe UI", Calibri, Arial, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--sans); background: #dcdcdc; color: var(--text); font-size: 13.5px; line-height: 1.55; }

  .cv { width: 210mm; height: 297mm; margin: 20px auto; background: #fff; box-shadow: 0 2px 14px rgba(0,0,0,.25); overflow: hidden; display: flex; flex-direction: column; }

  /* ---------- Encabezado ---------- */
  .top { background: var(--navy); color: #fff; padding: 38px 44px 34px; display: flex; align-items: center; gap: 30px; border-bottom: 5px solid var(--gold); }
  .foto { width: 140px; height: 140px; border-radius: 50%; border: 3px solid var(--gold); background: rgba(255,255,255,.08); display: flex; align-items: center; justify-content: center; text-align: center; font-size: 11.5px; color: #cfd6e2; overflow: hidden; flex-shrink: 0; cursor: pointer; }
  .foto img { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; }
  .top h1 { font-family: var(--serif); font-weight: 500; font-size: 42px; line-height: 1.05; letter-spacing: 1px; }
  .top .rol { color: var(--gold); letter-spacing: 4px; font-size: 12px; margin-top: 10px; text-transform: uppercase; }
  .top .linea { width: 60px; height: 2px; background: var(--gold); margin: 14px 0; }
  .top p { font-size: 12.5px; color: #dfe4ec; max-width: 430px; }

  /* ---------- Cuerpo ---------- */
  .cuerpo { display: flex; flex: 1; }
  .izq { width: 64%; padding: 32px 30px 30px 44px; }
  .der { width: 36%; background: var(--cream); padding: 32px 30px 30px 28px; border-left: 1px solid #eadfc2; }

  h2 { font-family: var(--serif); font-size: 21px; font-weight: 600; color: var(--navy); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 14px; display: flex; align-items: center; gap: 10px; }
  h2::after { content: ""; flex: 1; height: 1px; background: var(--gold); }
  section { margin-bottom: 28px; }

  .perfil { text-align: justify; }

  .item { margin-bottom: 16px; }
  .item .fecha { font-size: 11.5px; letter-spacing: 1.5px; color: var(--gold); font-weight: 700; text-transform: uppercase; }
  .item h3 { font-family: var(--serif); font-size: 18.5px; font-weight: 600; color: var(--navy); line-height: 1.2; margin: 2px 0; }
  .item .lugar { font-style: italic; font-size: 13px; margin-bottom: 6px; }
  .item ul { list-style: none; }
  .item li { position: relative; padding-left: 16px; margin-bottom: 4px; }
  .item li::before { content: "◆"; position: absolute; left: 0; top: 3px; font-size: 7px; color: var(--gold); }

  .der ul { list-style: none; }
  .der li { padding: 5px 0; border-bottom: 1px dotted #d9ccA6; font-size: 13px; }
  .der li:last-child { border-bottom: 0; }
  .contacto p { margin-bottom: 9px; font-size: 12.5px; word-break: break-all; }
  .contacto b { display: block; font-size: 10.5px; letter-spacing: 2px; color: var(--gold); text-transform: uppercase; }
  .nivel { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
  .barra { height: 4px; background: #e8dcb8; margin-bottom: 10px; }
  .barra i { display: block; height: 100%; background: var(--navy); }

  /* ---------- Botón (solo pantalla) ---------- */
  .btn { position: fixed; top: 14px; right: 14px; background: var(--navy); color: #fff; border: 0; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-size: 14px; box-shadow: 0 2px 6px rgba(0,0,0,.3); }
  .btn:hover { background: #12202f; }

  @media (max-width: 800px) {
    .cv { width: 100%; height: auto; margin: 0; }
    .top { flex-direction: column; text-align: center; }
    .cuerpo { flex-direction: column; }
    .izq, .der { width: 100%; padding: 24px; }
  }
  @media print {
    body { background: #fff; }
    .cv { margin: 0; box-shadow: none; }
    .btn { display: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
  @page { size: A4; margin: 0; }
</style>
</head>
<body>

<button class="btn" id="btn-pdf">Descargar PDF</button>
<input type="file" id="input-foto" accept="image/*" hidden>

<div class="cv">

  <header class="top">
    <div class="foto" id="foto" title="Haz clic para cambiar tu foto">
      <img src="data:image/jpeg;base64," alt="Foto de María Inés">
    </div>
    <div>
      <h1>María Inés<br>Coaquira Niña</h1>
      <div class="rol">Estudiante de Tecnologías de la Información</div>
      <div class="linea"></div>
      <p>Estudiante de Arquitectura de Plataformas y Servicios de TI, con experiencia práctica en fibra óptica y diseño gráfico.</p>
    </div>
  </header>

  <div class="cuerpo">
    <div class="izq">
      <section>
        <h2>Perfil</h2>
        <p class="perfil">Estudiante responsable, puntual y con disposición para aprender y trabajar en equipo. Con formación en tecnologías de la información y prácticas realizadas en instalación de fibra óptica y diseño gráfico. Busco una oportunidad laboral o de prácticas donde aplicar mis conocimientos y seguir creciendo profesionalmente.</p>
      </section>

      <section>
        <h2>Prácticas</h2>
        <div class="item">
          <div class="fecha">Enero - Marzo 2026 · 160 horas</div>
          <h3>Practicante pre-profesional</h3>
          <div class="lugar">Instituto de Educación Superior Tecnológico Público Santa Lucía</div>
          <ul>
            <li>Aprendí y practiqué la instalación de fibra óptica.</li>
            <li>Realicé trabajos de diseño gráfico.</li>
            <li>Cumplí 160 horas de prácticas con responsabilidad y puntualidad.</li>
          </ul>
        </div>
      </section>

      <section>
        <h2>Formación</h2>
        <div class="item">
          <div class="fecha">2023 - Actualidad</div>
          <h3>Arquitectura de Plataformas y Servicios de Tecnologías de la Información</h3>
          <div class="lugar">Instituto de Educación Superior Tecnológico Público Santa Lucía</div>
        </div>
      </section>
    </div>

    <aside class="der">
      <section class="contacto">
        <h2>Contacto</h2>
        <p><b>Teléfono</b>923 456 786</p>
        <p><b>Correo</b>mariacoaquira@gmail.com</p>
        <p><b>Ubicación</b>Santa Lucía, Perú</p>
      </section>

      <section>
        <h2>Habilidades</h2>
        <ul>
          <li>Instalación de fibra óptica</li>
          <li>Diseño gráfico</li>
          <li>Word y Excel</li>
          <li>Trabajo en equipo</li>
          <li>Comunicación asertiva</li>
          <li>Responsabilidad</li>
        </ul>
      </section>

      <section>
        <h2>Idiomas</h2>
        <div class="nivel"><span>Español</span><span>Nativo</span></div>
        <div class="barra"><i style="width:100%"></i></div>
        <div class="nivel"><span>Quechua</span><span>Intermedio</span></div>
        <div class="barra"><i style="width:65%"></i></div>
      </section>
    </aside>
  </div>

</div>

<script>
  // Subir foto haciendo clic en el círculo
  const foto = document.getElementById("foto");
  const input = document.getElementById("input-foto");
  foto.addEventListener("click", () => input.click());
  input.addEventListener("change", () => {
    const archivo = input.files[0];
    if (!archivo) return;
    const lector = new FileReader();
    lector.onload = (e) => { foto.innerHTML = '<img src="' + e.target.result + '" alt="Foto de María Inés">'; };
    lector.readAsDataURL(archivo);
  });
  // Descargar PDF: elige "Guardar como PDF" en la ventana de impresión
  document.getElementById("btn-pdf").addEventListener("click", () => window.print());
</script>
</body>
</html>
